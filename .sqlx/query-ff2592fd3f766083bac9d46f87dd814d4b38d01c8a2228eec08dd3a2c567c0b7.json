  "query": "\n            SELECT f.id as \"id!\", f.url, f.title, f.description, f.site_url, f.fetch_interval_minutes, f.consecutive_failures, f.backoff_until\n            FROM feeds f\n            JOIN subscriptions s ON s.feed_id = f.id\n            WHERE s.user_id = ? AND f.id > ?\n            ORDER BY f.id ASC\n            LIMIT ?\n            ",
